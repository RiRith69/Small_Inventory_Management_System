# =============================================================================
#  Warehouse Roll Inventory - environment variables
#  Copy this file to `.env` and fill in real values.  NEVER commit `.env`.
# =============================================================================

# ------------------------------------------------------------------ general
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Phnom_Penh
PROJECT_NAME=Warehouse Roll Inventory

# ----------------------------------------------------------------- database
# Local (bundled) PostgreSQL cluster created by scripts/dev-db.sh listens on 5433.
DATABASE_URL=postgresql+psycopg://warehouse:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@127.0.0.1:5433/warehouse_inventory
# Inside docker-compose use the service name instead:
# DATABASE_URL=postgresql+psycopg://warehouse:warehouse@db:5432/warehouse_inventory
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# PostgreSQL container bootstrap (docker-compose only)
POSTGRES_DB=warehouse_inventory
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_PORT=5433

# ----------------------------------------------------------------- security
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
SESSION_COOKIE_NAME=warehouse_session
SESSION_TTL_DAYS=30
# Set to true when the site is served over HTTPS (production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --------------------------------------------------------------- urls / cors
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_WEB_URL=http://localhost:5173
# Where the frontend should reach FastAPI from the browser
VITE_API_BASE_URL=http://localhost:8000

# ----------------------------------------------------------------- telegram
# From @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_TTL_MINUTES=10
# Shared secret used by the bot container to call the internal /api/bot/* routes
BOT_API_TOKEN=REPLACE_WITH_RANDOM_BOT_TOKEN
BACKEND_URL=http://127.0.0.1:8000

# ------------------------------------------------------------- rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
TELEGRAM_LINK_MAX_ATTEMPTS=5
TELEGRAM_LINK_WINDOW_MINUTES=15

# --------------------------------------------------- initial admin bootstrap
# Used only by:  python -m scripts.create_admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
